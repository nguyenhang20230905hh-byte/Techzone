# ===== Cơ sở dữ liệu (bắt buộc) =====
# Dùng Postgres miễn phí: Vercel Postgres, hoặc https://neon.tech, hoặc https://supabase.com
# Dạng: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/techzone?sslmode=require"

# ===== Xác thực (bắt buộc) =====
# Chuỗi bí mật bất kỳ để ký session. Tạo nhanh bằng: openssl rand -base64 32
NEXTAUTH_SECRET="thay-bang-chuoi-bi-mat-cua-ban"
# URL gốc của app. Local: http://localhost:3000 — Production: https://ten-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ===== Upload ảnh (tuỳ chọn) =====
# Không có biến này: ảnh vẫn upload được nhưng lưu tạm vào ổ đĩa (chỉ dùng được khi
# chạy local `npm run dev`; trên Vercel bắt buộc phải có biến này vì ổ đĩa không bền).
# Lấy token tại: Vercel Dashboard → Storage → Blob → Create → Connect
BLOB_READ_WRITE_TOKEN=""

# ===== AI tóm tắt bài viết (tuỳ chọn) =====
# Không có key: nút "Tóm tắt bằng AI" chạy ở CHẾ ĐỘ DEMO, có ghi rõ trên giao diện.
# Lấy key tại: https://console.anthropic.com
ANTHROPIC_API_KEY=""

# ===== Gửi email newsletter thật (tuỳ chọn) =====
# Không có key: email vẫn được lưu vào database, nhưng KHÔNG gửi email xác nhận thật.
# Lấy key tại: https://resend.com (có gói miễn phí)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TECHZONE <onboarding@resend.dev>"
