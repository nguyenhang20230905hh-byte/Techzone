// TECHZONE — schema cơ sở dữ liệu
// Dùng PostgreSQL để deploy thật trên Vercel (Vercel Postgres / Neon / Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER // thành viên: viết & đăng bài của chính mình
  ADMIN  // quản trị: chỉnh chuyên mục, banner, đánh dấu nổi bật/premium, xoá bình luận
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(MEMBER)
  bio           String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  // Hạn dùng gói Premium. null hoặc đã qua = chưa có / hết hạn. ADMIN luôn đọc được bài Premium.
  premiumUntil  DateTime?

  articles      Article[]
  comments      Comment[]
  savedArticles SavedArticle[]
  orders        Order[]
  notifications Notification[]

  @@map("authors")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  order       Int       @default(0)
  // Có xuất hiện thành khối chuyên mục riêng ở trang chủ (Khu vực H) hay không.
  showOnHome  Boolean   @default(true)
  createdAt   DateTime  @default(now())

  articles    Article[]

  @@map("categories")
}

model Tag {
  id       String        @id @default(cuid())
  name     String        @unique
  slug     String        @unique
  articles ArticleTag[]

  @@map("tags")
}

model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  summary         String
  content         String    // Markdown-lite: đoạn văn cách nhau bằng dòng trống, tiêu đề phụ bắt đầu bằng "## "
  // Tên tác giả hiển thị (bút danh chọn từ danh sách cố định ở lib/constants.ts) —
  // KHÁC với authorId/author bên dưới, vốn luôn là tài khoản ADMIN thực sự đăng bài.
  // null = bài cũ trước khi có tính năng này, hiển thị dùng tên tài khoản đăng (author.name).
  authorName      String?
  coverImageUrl   String
  coverImageAlt   String?
  coverImageCredit String?
  readingMinutes  Int       @default(5)
  isFeatured      Boolean   @default(false) // bài nổi bật chính của trang chủ (biên tập viên đánh dấu)
  isPremium       Boolean   @default(false) // bài cao cấp (paywall)
  status          String    @default("PUBLISHED") // PUBLISHED | DRAFT
  viewCount       Int       @default(0)
  publishedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])

  tags            ArticleTag[]
  comments        Comment[]
  views           ArticleView[]
  savedBy         SavedArticle[]
  aiSummary       AISummary?

  @@index([categoryId])
  @@index([publishedAt])
  @@map("articles")
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

// Mỗi lượt xem một bản ghi có dấu thời gian -> tính được "đọc nhiều trong 7 ngày"
// hoặc tổng lượt xem tuỳ nhu cầu hiển thị.
model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([articleId, viewedAt])
  @@map("article_views")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  articleId String
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())
  isDeleted Boolean   @default(false) // xoá mềm để vẫn giữ mạch bình luận

  // Phản hồi 1 cấp: parentId trỏ tới bình luận GỐC (không trỏ sang 1 phản hồi
  // khác) — giữ giao diện đơn giản kiểu "1 bình luận + các phản hồi bên dưới",
  // không lồng phản hồi-của-phản hồi. null = bình luận gốc trên bài viết.
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([articleId])
  @@index([parentId])
  @@map("comments")
}

// Thông báo cho 1 người dùng cụ thể (admin hoặc thành viên):
//  - NEW_COMMENT: admin nhận khi có khán giả bình luận/phản hồi về 1 bài viết.
//  - COMMENT_REPLY: tác giả 1 bình luận nhận khi có người (admin hoặc độc giả
//    khác) phản hồi lại đúng bình luận của họ.
//  - NEW_ARTICLE: mọi thành viên nhận khi admin đăng bài viết mới.
model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  message     String
  articleSlug String?
  commentId   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model SavedArticle {
  userId    String
  articleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@id([userId, articleId])
  @@map("saved_articles")
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  isConfirmed Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("newsletter_subscribers")
}

// Bản tóm tắt AI được cache lại theo bài viết, tránh gọi API lặp lại tốn phí.
model AISummary {
  id        String   @id @default(cuid())
  articleId String   @unique
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  points    String   // JSON.stringify(string[]) — 3-5 ý chính
  conclusion String
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("ai_summaries")
}

// Cấu hình để "mọi chức năng đều tự điều chỉnh được" — banner quảng cáo, slogan...
// thay đổi được từ trang /admin, không cần sửa code.
model SiteSetting {
  key   String @id
  value String // JSON string

  @@map("site_settings")
}

// Danh sách email được ADMIN duyệt trước — chỉ những email có trong bảng này
// mới đăng ký (và vì vậy mới đăng bài) được. Quản lý tại /admin, không cần sửa code.
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())

  @@map("allowed_emails")
}

// Đơn đăng ký Premium. Hiện ở chế độ MÔ PHỎNG (simulated = true): không có tiền thật chạy.
// Khi tích hợp cổng thanh toán thật, tạo đơn trạng thái PENDING rồi chuyển PAID khi webhook xác nhận.
model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String   // "1m" | "6m" | "12m" | "grant" (admin tặng)
  planName  String
  months    Int
  amount    Int      // VND, 0 nếu admin tặng
  method    String   // card | wallet | bank | admin
  status    String   @default("PAID") // PENDING | PAID | REFUNDED
  simulated Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("orders")
}
